{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MissionIntelligenceReport",
  "description": "Advisory Mission Intelligence Report Payload produced by Python AI Service",
  "type": "object",
  "properties": {
    "timestamp": { "type": "number" },
    "missionId": { "type": "string" },
    "currentState": { "type": "string" },
    "anomalies": { "type": "array" },
    "riskAssessment": { "type": "object" },
    "predictions": { "type": "object" },
    "missionHealth": { "type": "object" },
    "recommendedActions": { "type": "array" },
    "plannerRecommendation": { "type": "object" },
    "confidence": { "type": "number" },
    "explanation": { "type": "object" }
  },
  "required": ["timestamp", "missionId", "anomalies", "riskAssessment", "predictions", "missionHealth", "recommendedActions"]
}
