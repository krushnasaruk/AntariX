{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InferenceRequest",
  "description": "Versioned ML/RL Inference Request Schema",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "modelId": { "type": "string" },
    "modelVersion": { "type": "string" },
    "observation": { "type": "object" },
    "features": { "type": "array" }
  },
  "required": ["modelId", "observation"]
}
