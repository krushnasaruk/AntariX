{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluationReport",
  "description": "Versioned Evaluation Report Schema for Models & Policies",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "modelId": { "type": "string" },
    "modelVersion": { "type": "string" },
    "inDistributionMetrics": { "type": "object" },
    "outOfDistributionMetrics": { "type": "object" },
    "safetyMetrics": { "type": "object" },
    "robustnessPass": { "type": "boolean" },
    "passed": { "type": "boolean" }
  },
  "required": ["modelId", "modelVersion", "inDistributionMetrics", "safetyMetrics", "passed"]
}
