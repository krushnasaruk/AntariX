# Server Ports
PORT=4000
FRONTEND_PORT=5173
AI_ENGINE_PORT=5000

# Earth-Mars Communication Simulator Configuration
# Mode options: "demo" (0s delay), "opposition" (204s / ~3.4 min), "conjunction" (1344s / ~22.4 min)
COMMUNICATION_MODE=demo
COMMUNICATION_LATENCY_SECONDS=5
PACKET_LOSS_RATE=0.02
BLACKOUT_SIMULATION_ENABLED=false

# Rover Telemetry Configuration
ROVER_INITIAL_SOL=142
SIMULATION_TICK_RATE_MS=1000

# AI Engine Settings
AI_AUTONOMY_LEVEL=FULL_AUTONOMOUS
ANOMALY_DETECTION_THRESHOLD=0.85
